{
  "_comment": "Example hooks, NOT active. Run /hooks enable to copy them into .euron/settings.json (they are pre-trusted because Euron Code wrote them). Edit freely.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "timeout": 60,
        "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const p=(JSON.parse(d).tool_input||{}).path||'';if(/\\.(js|jsx|ts|tsx|css|json|md)$/.test(p))require('child_process').spawnSync('npx',['--no-install','prettier','--write',p],{stdio:'inherit',shell:true})})\""
      }
    ]
  }
}
